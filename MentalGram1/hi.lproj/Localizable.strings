"postpred.help.howitworks.step1" = "अपना **सेट** तैयार करें — पहले से फोटो अपलोड करें और ऐप को स्वचालित रूप से संग्रहित करने दें। जब तक आप प्रकट नहीं करते, वे Instagram पर अदृश्य रहते हैं।";
"postpred.help.howitworks.step2" = "दर्शक स्वतंत्र रूप से एक शब्द, संख्या, छवि या कार्ड चुनता है। आप इनपुट विधियों में से एक का उपयोग करके उसकी पसंद चुपचाप कैप्चर करते हैं।";
"postpred.help.howitworks.step3" = "प्रकटीकरण शुरू करें। संबंधित फोटो वास्तविक Instagram पर **मूल स्थान और मूल तारीख** के साथ फिर से दिखती है — जैसे वह हमेशा वहाँ थी।";
"postpred.help.howitworks.body1" = "आप एक **सेट** तैयार करते हैं, हर अक्षर या अंक के लिए एक फोटो का संग्रह। फोटो पहले से अपलोड होती हैं और स्वचालित रूप से संग्रहित हो जाती हैं।";
"postpred.help.howitworks.body2" = "जब आप प्रकटीकरण शुरू करते हैं, ऐप संबंधित फोटो का संग्रह हटा देती है। वह **मूल ग्रिड स्थिति** पर, **मूल तारीख** के साथ फिर दिखती है।";
"postpred.help.howitworks.info" = "दर्शक एक असली Instagram प्रोफाइल पर एक असली पोस्ट देखता है। कोई ऐप दिखाई नहीं देती।";
"postpred.help.howitworks.archive_reason" = "Instagram नई फोटो अपलोड करके उसे पुरानी तारीख देने की अनुमति नहीं देता। Vault भविष्यवाणी वाली तस्वीरों को पहले से अपलोड करके तुरंत archive कर देता है। Instagram मूल अपलोड तारीख और grid position को बनाए रखता है, इसलिए बाद में unarchive की गई prediction ऐसी दिखती है जैसे वह पुरानी पोस्ट हमेशा से वहीं थी। Upload और archive अपने आप और तुरंत होते हैं, इसलिए दर्शक आपके असली profile पर तैयारी वाली तस्वीरें कभी नहीं देखते।";
"set.input.numpadcard.help" = "Performance opens on a black screen. Tap anywhere to show an elegant card pad, choose the value and suit, and the pad disappears. The localized card name can fill Notes/Bio and an active Playing Cards set reveals that card.";
