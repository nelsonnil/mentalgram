"faq.q.slow_load.question" = "मेरा प्रोफ़ाइल लोड होने में कुछ सेकंड क्यों लगते हैं?";
"faq.q.slow_load.answer" = "जब आप Performance खोलते हैं, तो ऐप Instagram से आपका नवीनतम डेटा लाने के लिए कनेक्ट होती है — पोस्ट, फ़ॉलोअर, प्रोफ़ाइल फ़ोटो आदि। यह आपके इंटरनेट कनेक्शन और Instagram के सर्वर की व्यस्तता के आधार पर 2–5 सेकंड लेता है। कोई समस्या नहीं है: यह बिल्कुल वैसी ही देरी है जो धीमे कनेक्शन पर असली Instagram ऐप में भी होती है।";
"faq.q.slow_load.tip" = "मंच टिप: अगर दर्शक लोडिंग देखें, तो लोड होते समय कहें \"Instagram खोल रहा हूँ\" — वे मान लेंगे कि यह सामान्य नेटवर्क देरी है, जो वास्तव में सच है।";

"faq.q.refresh.question" = "क्या Performance खोलने पर हर बार प्रोफ़ाइल रिफ्रेश होती है?";
"faq.q.refresh.answer" = "हाँ, प्रति सत्र एक बार। ऐप Instagram से ताज़ा डेटा लाती है और उसे कैश करती है ताकि सामग्री सटीक रहे। अगर आप उसी 90-सेकंड विंडो में Performance फिर से खोलते हैं, तो कैश्ड संस्करण तुरंत दिखता है — कोई नया अनुरोध नहीं।";

"faq.q.new_photo.question" = "मैंने Instagram पर नई फ़ोटो अपलोड की। कब दिखेगी?";
"faq.q.new_photo.answer" = "आपकी नई फ़ोटो अगली बार Performance खोलने पर दिखेगी — आमतौर पर Instagram पर पोस्ट करने के 90 सेकंड के भीतर। ऐप हमेशा प्रवेश पर नवीनतम पोस्ट लाती है, इसलिए आपको कुछ भी मैन्युअली करने की ज़रूरत नहीं।";

"faq.q.reels_slow.question" = "Reels और Tagged सामग्री धीरे दिखती है। क्या यह सामान्य है?";
"faq.q.reels_slow.answer" = "Reels और टैग की गई फ़ोटो आपकी पोस्ट दिखने के कुछ सेकंड बाद बैकग्राउंड में अपने आप लोड होती हैं, ताकि आपके उन टैब पर स्वाइप करने से पहले तैयार हों। एक बार लोड होने पर सेव हो जाती हैं और भविष्य के सत्रों में तुरंत दिखती हैं — इंटरनेट की ज़रूरत नहीं।";

"faq.q.no_data.question" = "Performance खोलते समय इंटरनेट न हो तो क्या होगा?";
"faq.q.no_data.answer" = "आपके प्रोफ़ाइल का अंतिम सहेजा संस्करण कैश से तुरंत दिखाया जाता है — पोस्ट, प्रोफ़ाइल फ़ोटो, काउंटर सब कुछ। कनेक्शन वापस आने पर ऐप चुपचाप रिफ्रेश करने की कोशिश करेगी, लेकिन आप ऑफलाइन भी बिना किसी रुकावट के प्रदर्शन कर सकते हैं।";

"faq.q.bot.question" = "क्या Vault का उपयोग मेरा Instagram अकाउंट सस्पेंड कर सकता है?";
"faq.q.bot.answer" = "Vault Instagram की सीमाओं को ध्यान में रखकर बनाया गया है। यह अनुरोधों को स्वचालित रूप से फैलाता है, कूलडाउन का सम्मान करता है और कभी भी बड़े पैमाने पर कार्रवाई नहीं भेजता। सामान्य उपयोग में जोखिम न्यूनतम है। बहुत कम समय में दर्जनों ट्रिक्स एक के बाद एक करने से बचें — ऐप इसे पहले से स्वचालित रूप से रोकती है।";

"faq.q.not_instagram.question" = "दर्शक पूछते हैं कि ऐप Instagram जैसी क्यों दिखती है। क्या कहूँ?";
"faq.q.not_instagram.answer" = "Performance आपके Instagram प्रोफ़ाइल की एक वफ़ादार दृश्य प्रतिकृति है — वही लेआउट, वही फ़ोटो, वही काउंटर। अगर कोई पूछे, तो आप बस कह सकते हैं कि आप अपना Instagram चेक कर रहे हैं, क्योंकि दिखाया गया डेटा वास्तविक है और आपके अकाउंट से लाइव है।";

