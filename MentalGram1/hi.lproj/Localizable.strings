"postpred.help.tip.vibration" = "**कंपन = तैयार।** हैप्टिक फीडबैक संकेत है कि फोटो असली Instagram पर लाइव है।";
"postpred.help.tip.ring" = "**नारंगी रिंग = पुष्टि।** सफल reveal के बाद, आपकी प्रोफ़ाइल फ़ोटो के चारों ओर एक नारंगी ग्रेडिएंट रिंग दिखाई देती है — बिल्कुल Instagram Story रिंग जैसी। यह पुष्टि करती है कि फ़ोटो असली Instagram पर लाइव है। नई Performance सत्र खोलने पर रिंग स्वचालित रूप से रीसेट हो जाती है।";
"postpred.help.tip.position" = "**मूल स्थिति।** फोटो ग्रिड में ठीक उसी स्थान पर, मूल तारीख के साथ दिखती है।";
"postpred.help.tip.upload" = "**अपलोड के दौरान।** ऐप का उपयोग न करें, Wi-Fi नेटवर्क न बदलें, स्क्रीन लॉक न करें।";
"postpred.help.tip.banks" = "**बैंकों की संख्या।** प्रत्येक बैंक = एक अक्षर या अंक स्थान।";
"postpred.help.tip.fakeapp" = "**फ़ेक प्रोफ़ाइल = तत्काल प्रीव्यू, असली Instagram = वाइब्रेशन के बाद।** भविष्यवाणी ऐप के फ़ेक प्रोफ़ाइल में तुरंत दिखती है — लेकिन असली Instagram पर अभी उपलब्ध नहीं है। आगे बढ़ने से पहले हैप्टिक फ़ीडबैक का इंतज़ार करें।";
"postpred.help.tip.openprofile" = "**पहले अपना असली Instagram प्रोफ़ाइल खोलें।** वाइब्रेशन से अपलोड की पुष्टि होने के बाद, दर्शक को देखने के लिए आमंत्रित करने से पहले अपना Instagram प्रोफ़ाइल खोलें। इससे फ़ीड में कंटेंट लोड होगा — अगर दर्शक पहले रिफ़्रेश करे, तो उसे नीचे स्क्रॉल करना पड़ सकता है।";

