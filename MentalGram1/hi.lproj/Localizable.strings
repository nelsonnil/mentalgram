// ── Limits & Safety help (simplified) ──
"limits.help.title" = "सीमाएँ और सुरक्षा";

"limits.help.calm.title" = "आराम करें — सब कुछ नियंत्रण में है";
"limits.help.calm.body" = "Instagram कभी-कभी एक संक्षिप्त सूचना दिखाता है जिसमें पुष्टि करनी होती है कि यह आप ही हैं। यह प्लेटफ़ॉर्म से जुड़े किसी भी ऐप के लिए पूरी तरह सामान्य है और बैन से इसका कोई संबंध नहीं है। Vault को उन्हीं एंटी-बॉट सुरक्षा उपायों के साथ डिज़ाइन किया गया है जो असली ऐप उपयोग करते हैं, और प्रत्येक का गहन परीक्षण किया गया है।";
"limits.help.calm.infobox" = "मैंने व्यक्तिगत रूप से विकास के दौरान इस तरह की चेतावनी 100 से अधिक बार ट्रिगर की है और मेरे अकाउंट को कभी भी बैन नहीं किया गया। उसी दृष्टिकोण वाले अन्य ऐप बिना किसी समस्या के काम करते हैं — यदि कोई वास्तविक जोखिम होता, तो Vault प्रकाशित नहीं होता।";

"limits.help.budget.title" = "आपका प्रति घंटा बजट क्या खर्च करता है";
"limits.help.budget.intro" = "Instagram प्रति सत्र प्रति घंटे लगभग 55 API क्रियाओं की अनुमति देता है। ऐप इसे स्वचालित रूप से ट्रैक करता है। यहाँ देखें क्या गिना जाता है — और क्या नहीं:";
"limits.help.budget.free" = "मुफ़्त";
"limits.help.budget.free.items" = "ग्रिड स्क्रॉल करना · वॉल्यूम बटन एनिमेशन · गुप्त नंबर टाइप करना · पहले से खुले प्रोफ़ाइल देखना (कैश) · सेटिंग्स या गाइड ब्राउज़ करना";
"limits.help.budget.low" = "कम";
"limits.help.budget.low.items" = "ऐप खोलना (1) · फॉलोअर लिस्ट लोड करना (1) · अक्षर/फ़ोटो प्रकट करना (प्रत्येक 1) · काउंटर ग्लिच — नया प्रोफ़ाइल पहली बार खोलना (4) · प्रोफ़ाइल खोजना (2)";
"limits.help.budget.high" = "अधिक";
"limits.help.budget.high.items" = "Sync & Archive — प्रति फ़ोटो 2 कॉल · फ़ोटो अपलोड करना — प्रति फ़ोटो 1 कॉल · 5 अलग फॉलोअर प्रोफ़ाइल खोलना — लगभग 20 कॉल";
"limits.help.budget.reset" = "बजट हर 60 मिनट में रीसेट होता है। यदि ऐप स्वचालित रूप से रुक जाता है, तो इसका मतलब है कि आपने प्रति घंटे की सीमा समाप्त कर दी — बस प्रतीक्षा करें और यह अपने आप फिर शुरू हो जाएगा।";
"limits.help.rehearsal.title" = "सुरक्षित अभ्यास — सुनहरे नियम";
"limits.help.rehearsal.body" = "अधिकतर बॉट डिटेक्शन शो के दौरान नहीं बल्कि परीक्षण के दौरान होती है। कुछ सरल आदतें 90% जोखिम समाप्त कर देती हैं:";
"limits.help.rehearsal.tip1" = "एक ही फॉलोअर का प्रोफ़ाइल एक बार खोलें → दिनों तक कैश रहता है। उसी व्यक्ति के साथ जितनी बार चाहें काउंटर ग्लिच का अभ्यास करें — बिल्कुल मुफ़्त।";
"limits.help.rehearsal.tip2" = "Sync & Archive और फ़ोटो अपलोड को अलग-अलग घंटों में फैलाएं — शो से ठीक पहले इन्हें एक साथ न करें।";
"limits.help.rehearsal.avoid1" = "अभ्यास के दौरान एक के बाद एक 4-5 अलग फॉलोअर प्रोफ़ाइल न खोलें। हर नया प्रोफ़ाइल ~4 API कॉल खर्च करता है।";
"limits.help.rehearsal.avoid2" = "परीक्षण के दौरान ऐप को बार-बार पुनः आरंभ न करें — हर पुनरारंभ से सत्र जाँच सक्रिय होती है।";
"limits.help.rehearsal.tip" = "सबसे सुरक्षित अभ्यास: ठीक उसी फॉलोअर को खोलें जिसे आप उपयोग करेंगे, प्रभाव एक बार करें, वापस जाएं। उसी क्रम को दोहराएं → दूसरी बार से यह पूरी तरह मुफ़्त है।";
"limits.help.warning.title" = "यदि \"असामान्य गतिविधि\" की चेतावनी दिखे";
"limits.help.warning.intro" = "चिंता न करें — यह बैन नहीं है। यह सिर्फ़ Instagram की पुष्टि है कि यह वाकई आप हैं। इन चरणों का पालन करें:";
"limits.help.warning.step1" = "आधिकारिक Instagram ऐप खोलें और चेतावनी पर \"Dismiss\" टैप करें।";
"limits.help.warning.step2" = "यदि सत्यापन मांगे, तो ईमेल या SMS कोड से पूरा करें।";
"limits.help.warning.step3" = "Vault में सेटिंग्स से लॉग आउट करें, लगभग एक मिनट रुकें, और फिर से लॉग इन करें।";
"limits.help.warning.step4" = "जारी रखने के लिए तैयार — आपका अकाउंट सुरक्षित है।";
"limits.help.warning.reassure" = "आपका अकाउंट बिल्कुल ठीक से काम करता रहता है। यह केवल कुछ मिनटों के लिए Vault को रोकता है, और कुछ नहीं।";

"limits.help.show.title" = "प्रदर्शन के दौरान";
"limits.help.show.body" = "यदि दर्शक स्क्रीन देख रहा हो और कोई चेतावनी आए, तो Vault सभी तकनीकी विवरण छिपाकर एक सामान्य \"कोई इंटरनेट कनेक्शन नहीं\" स्क्रीन दिखाता है।";
"limits.help.show.infobox" = "सही बहाना: \"अरे, Instagram एक पल के लिए गड़बड़ा गया, कोई बड़ी बात नहीं।\" कोई भी दर्शक तकनीकी कुछ नहीं देखेगा।";

"limits.help.best.title" = "सर्वोत्तम प्रथाएँ";
"limits.help.best.item1" = "एक ही सत्र में एक ही प्रभाव को कई बार लगातार न दोहराएँ — एल्गोरिथम इसे स्वचालित मान सकता है।";
"limits.help.best.item2" = "अपने सेट (Sync & Archive) को शो से एक रात पहले या कम से कम एक घंटे पहले तैयार करें, अभ्यास के तुरंत बाद नहीं।";
"limits.help.best.item3" = "यदि आप अक्सर प्रदर्शन करते हैं, तो मुख्य से अलग एक समर्पित Instagram अकाउंट का उपयोग करें।";
"limits.help.best.item4" = "Vault सभी प्रतीक्षा समयों को स्वचालित रूप से प्रबंधित करता है — आपको कुछ भी सोचने की आवश्यकता नहीं।";

"limits.help.testing.title" = "Instagram सुरक्षा जाँच क्यों माँग सकता है?";
"limits.help.testing.body" = "ऐप परीक्षण के दौरान Instagram का असामान्य गतिविधि का पता लगाना सामान्य है। परीक्षण करते समय, कम समय में कई क्रियाएं एक के बाद एक की जाती हैं — बायो बदलना, नोट्स, फ़ोटो खुलासे — और नए अकाउंट पर, जो Instagram के सुरक्षा प्रणालियों को स्वचालित व्यवहार जैसा लग सकता है।\n\nवास्तविक प्रदर्शन में यह कभी नहीं होता: क्रियाएं प्रदर्शन की प्राकृतिक गति से स्वाभाविक रूप से अलग होती हैं, जिससे सब कुछ सामान्य मानवीय उपयोग जैसा दिखता है।";
"limits.help.testing.fix" = "यदि Instagram ईमेल या फ़ोन नंबर सत्यापित करने को कहे, तो यह केवल एक बार की सुरक्षा जाँच है। ब्राउज़र पर instagram.com से इसे पूरा करें और अकाउंट फिर से सामान्य रूप से काम करेगा।";

"limits.help.session.title" = "अगर app \"इंटरनेट नहीं\" स्क्रीन दिखाए";
"limits.help.session.body" = "कभी-कभी Instagram अस्थायी रूप से सत्र रद्द कर देता है — तब app एक सामान्य \"कोई कनेक्शन नहीं\" स्क्रीन दिखाता है ताकि दर्शक कुछ तकनीकी न देखें। यह बैन नहीं है।\n\nवास्तविक स्पष्टीकरण देखने और समस्या हल करने के लिए, उस स्क्रीन के नीचे-दाएं कोने में ⓘ बटन टैप करें।";
"limits.help.session.case1.label" = "केवल Dismiss बटन दिखाई देता है";
"limits.help.session.case1.action" = "Instagram app में Dismiss टैप करें और सीधे यहां वापस आकर फिर से लॉग इन करें। प्रतीक्षा करने की जरूरत नहीं — तुरंत अंदर आ जाएंगे।";
"limits.help.session.case2.label" = "कोई विशिष्ट समाप्ति तिथि दिखाई दे";
"limits.help.session.case2.action" = "उस तिथि तक प्रतीक्षा करें, फिर वापस आकर लॉग इन करें। Instagram ने एक छोटा कूलडाउन लगाया है — आपका अकाउंट ठीक है।";
"limits.help.session.case3.label" = "फोन या ईमेल से कोड मांगा जाए";
"limits.help.session.case3.action" = "पहले Instagram app में सत्यापन पूरा करें। उसके बाद यहां वापस आएं और पुनः लॉग इन करें टैप करें।";
"limits.help.session.new_account" = "कम गतिविधि इतिहास वाले नए अकाउंट को यह ज्यादा होता है। धीरे-धीरे पोस्ट, फॉलोअर्स और इंटरेक्शन बढ़ाएं — Instagram स्थापित इतिहास वाले अकाउंट पर बहुत अधिक भरोसा करता है।";
"limits.help.session.contact" = "अगर बॉट डिटेक्शन बार-बार हो रहा है, तो डेवलपर से संपर्क करें और अपने लॉग शेयर करें (सेटिंग्स → लॉग एक्सपोर्ट करें)। इससे समस्या का विश्लेषण करने और सभी के लिए सुरक्षा बेहतर बनाने में मदद मिलती है।";

"limits.help.gauge.title" = "आपका प्रति घंटे 55 एक्शन का बजट";
"limits.help.gauge.body" = "Instagram हर कनेक्टेड ऐप को प्रति घंटे 55 एक्शन तक सीमित करता है। बजट 60 मिनट की रोलिंग विंडो के रूप में काम करता है — हर एक्शन ठीक 60 मिनट बाद एक्सपायर होता है, इसलिए काउंटर बिना किसी हार्ड रीसेट के अपने आप कम होता जाता है।";
"limits.help.gauge.cache" = "दूसरी बार से Performance खोलने का खर्च 0 है — सब कुछ आपके डिवाइस पर स्थायी रूप से सेव है। केवल पहली बार (या अकाउंट बदलने के बाद) पूरी प्रोफ़ाइल डाउनलोड और कैश करने में 3–5 एक्शन लगते हैं।";
"limits.help.gauge.hardstop" = "जब 55 की सीमा पहुंच जाती है, तो ऐप स्वचालित रूप से Instagram पर कोई भी अतिरिक्त अनुरोध भेजना बंद कर देता है। कुछ भी नहीं भेजा जाता, कुछ भी ट्रिगर नहीं होता — यह चुपचाप इंतजार करता है जब तक बजट नवीनीकृत नहीं हो जाता। आपको कुछ नहीं करना है।";
"limits.help.gauge.zone.safe" = "सुरक्षित (>20)";
"limits.help.gauge.zone.low" = "कम (8–20)";
"limits.help.gauge.zone.critical" = "खतरनाक (<8)";

"limits.help.table.title" = "हर फ़ीचर में उपयोग होने वाले एक्शन";
"limits.help.table.subtitle" = "पहले उपयोग पर खर्च बनाम पहले से कैश्ड होने पर।";
"limits.help.table.col.action" = "फ़ीचर";
"limits.help.table.col.first" = "पहली बार";
"limits.help.table.col.again" = "दोबारा";
