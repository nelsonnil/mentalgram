"guide.amnesia.row.title" = "एम्नेसिया कैरोसेल";
"guide.amnesia.row.subtitle" = "सम्मोहन स्मृति प्रभाव — 5वीं छवि छुपाएं, Instagram पर प्रकट करें";
"guide.amnesia.hero_subtitle" = "सम्मोहन स्मृति प्रभाव · Instagram सत्यापित";
"guide.amnesia.what.title" = "यह क्या है?";
"guide.amnesia.what.body" = "वास्तविक Instagram पर सत्यापन के साथ एक सम्मोहन स्मृतिलोप प्रभाव। आप 5 छवियों का कैरोसेल अपलोड करते हैं, लेकिन शुरुआत में केवल 4 दिखती हैं। दर्शक उन्हें याद करता है, Instagram बंद करता है और आप ऐप से ट्रिगर सक्रिय करते हैं। जब वे Instagram फिर खोलते हैं तो 5 छवियां दिखती हैं — मूल अपलोड तिथि के साथ।";
"guide.amnesia.trigger.title" = "ट्रिगर";
"guide.amnesia.trigger.body" = "ऐप में कैरोसेल खोलने और बंद करने पर एक आदेश स्वचालित रूप से सक्रिय होता है।\n\n⚡ सही क्रम:\n1. दर्शक Instagram खोलता है और 4 छवियां + तिथि देखता है।\n2. दर्शक Instagram बंद करता है।\n3. आप ऐप में कैरोसेल खोलते और बंद करते हैं → ट्रिगर सक्रिय।\n4. दर्शक Instagram फिर खोलता है → 5 छवियां, वही तिथि।\n\n❌ यदि दर्शक के कैरोसेल देखने से पहले ट्रिगर सक्रिय करते हैं, तो वे सीधे 5 छवियां देखेंगे।";
"guide.amnesia.hidden.title" = "छुपी छवि";
"guide.amnesia.hidden.body" = "5वीं छवि (ऐप में नारंगी बॉर्डर से चिह्नित) वह है जो शुरू में Instagram पर संग्रहीत है। दर्शक पहली बार इसे नहीं देखता — यह केवल अंतिम सत्यापन में दिखती है।";
"guide.amnesia.options.title" = "ट्रिगर सक्रिय करने के दो तरीके";
"guide.amnesia.optionA.title" = "हाथ के इशारे (अधिक नाटकीय)";
"guide.amnesia.optionA.body" = "दर्शक Instagram बंद करता है। आप कहते हैं 'मैं भी बंद करता हूं' और ऐप में कैरोसेल बंद करते हैं। दर्शक की आंखें बंद होने पर बात करते हुए हाथ के इशारे करते हैं। स्वैप पृष्ठभूमि में होता है।";
"guide.amnesia.optionB.title" = "गुप्त स्क्रॉलिंग (अधिक अदृश्य)";
"guide.amnesia.optionB.body" = "जब दर्शक स्मृति के बारे में आपकी बात सुन रहा हो, आप ऐप में आराम से स्क्रॉल करके कैरोसेल बंद करते हैं। दर्शक इस इशारे को प्रभाव से नहीं जोड़ता।";
"guide.amnesia.date.title" = "तिथि सत्यापन — अंतिम प्रहार";
"guide.amnesia.date.body" = "शुरुआत में दर्शक को पोस्ट की अपलोड तिथि नोट करने के लिए कहें। अंत में जब वे 5 छवियां देखें, पूछें:\n\n'क्या यह वही तिथि है जो आपने पहले देखी थी?'\n\nहमेशा वही होती है — क्योंकि दोनों कैरोसेल एक साथ अपलोड हुए थे। Instagram तिथियां नहीं बदल सकता।";
"guide.amnesia.script.title" = "प्रदर्शन स्क्रिप्ट";
"guide.amnesia.script.opening.phase" = "शुरुआत";
"guide.amnesia.script.opening.text" = "'अपना फोन निकालिए। मेरा Instagram खोलिए और यह पोस्ट ढूंढिए। इसे खोलिए... समय लीजिए। हर छवि को एक-एक करके देखिए। पोस्ट के नीचे अपलोड तिथि भी नोट करिए। इसे याद करिए — यह महत्वपूर्ण है। सब याद हो गया? और तिथि? अच्छा।'";
"guide.amnesia.script.close.phase" = "INSTAGRAM बंद करें";
"guide.amnesia.script.close.text" = "'अब ऐप स्विचर से Instagram पूरी तरह बंद करिए। ये छवियां कुछ देर के लिए केवल आपके मन में रहेंगी। मैं नहीं चाहता कि कोई बाहरी चीज आपको प्रभावित करे।'";
"guide.amnesia.script.optionA.phase" = "विकल्प A — हाथ के इशारे";
"guide.amnesia.script.optionA.text" = "'मैं भी बंद करता हूं।' [जादूगर ऐप में कैरोसेल बंद करता है → स्वैप सक्रिय]\n\n'अब हम दोनों डिस्कनेक्ट हैं। केवल छवियां बची हैं... यहां।' [सिर की ओर इशारा]\n\n[आंखें बंद] हाथ फैलाकर: 'हर गतिविधि के साथ... एक छवि धुंधली होती जा रही है...' [तीन धीमे इशारे]\n\n'हो गया। आंखें खोलिए।'";
"guide.amnesia.script.optionB.phase" = "विकल्प B — गुप्त स्क्रॉलिंग";
