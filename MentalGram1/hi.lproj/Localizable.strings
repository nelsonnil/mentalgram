"limits.help.table.row.followers" = "फॉलोअर्स लिस्ट";
"limits.help.table.row.profile.new" = "नया फॉलोअर प्रोफ़ाइल";
"limits.help.table.row.profilepic" = "प्रोफ़ाइल फोटो बदलें";
"limits.help.table.row.sa" = "Sync & Archive (प्रति फ़ोटो)";
"limits.help.table.row.upload" = "अपलोड (प्रति फ़ोटो)";
"limits.help.table.row.autoupload" = "ऑटो-अपलोड पूरा चक्र (प्रति फ़ोटो)";
"limits.help.table.row.reveal" = "रिवील (प्रति अक्षर/फ़ोटो)";
"limits.help.table.row.notebio" = "नोट या बायो बदलें";
"limits.help.table.row.explore" = "एक्सप्लोर / सर्च";
"limits.help.sa.auto" = "रिवील और प्रोफ़ाइल विज़िट के साथ पूरे परफॉर्मेंस के बाद, ऐप Sync & Archive से पहले स्वचालित रूप से एक छोटी प्रतीक्षा अवधि जोड़ता है। यह सामान्य है — यह आपके सेशन को सुरक्षित रखता है।";
"limits.help.table.cache.lost" = "पहली लोड के बाद Performance पूरी तरह डिवाइस पर सेव हो जाता है — इसके बाद हर बार 0 एक्शन। पहली बार (या अकाउंट बदलने के बाद) प्रोफ़ाइल डाउनलोड और सेव होते समय लोडिंग स्क्रीन दिखती है। Settings में Refresh तभी दबाएं जब आपने असली Instagram पर कुछ बदला हो (नई पोस्ट, bio बदलाव आदि)।";
"limits.help.table.batch.note" = "प्रति फ़ोटो लागत जुड़ती है। 4 फ़ोटो पर Sync & Archive = कुल 8 एक्शन। 4 फ़ोटो अपलोड करना = कुल 9 (1 तैयारी कॉल + प्रति फ़ोटो 2)। प्रोफ़ाइल फोटो बजट में 1 एक्शन दिखाती है, हालांकि Instagram को इमेज अपलोड कॉल भी मिलती है।";

"limits.help.profiles.title" = "प्रोफ़ाइल विज़िट — सबसे महंगा एक्शन";
"limits.help.profiles.body" = "नई फॉलोअर प्रोफ़ाइल खोलने पर आमतौर पर 3–4 एक्शन खर्च होते हैं। उसी प्रोफ़ाइल की तेज़ दूसरी विज़िट कैश से लोड होती है, लेकिन बाद का रिफ्रेश फिर से बजट उपयोग कर सकता है। इसीलिए 3–4 अलग-अलग प्रोफ़ाइल तेजी से खोलने से बजट खत्म हो सकता है और बॉट डिटेक्शन ट्रिगर हो सकती है।";
"limits.help.profiles.max" = "सुझाव: प्रति सेशन अधिकतम 2 नई प्रोफ़ाइल खोलें। Sync & Archive से ठीक पहले नई प्रोफ़ाइल विज़िट करने से बचें।";
"limits.help.reddot.title" = "लाल बिंदु";
