// MARK: - FAQ Help View
"guide.faq.section" = "FAQ";
"guide.faq.row.title" = "常见问题";
"guide.faq.row.subtitle" = "用简单语言解释正常行为 — 加载、刷新等";
"faq.help.title" = "常见问题";

"faq.q.slow_load.question" = "为什么我的个人资料加载需要几秒钟？";
"faq.q.slow_load.answer" = "打开 Performance 时，应用会连接到 Instagram 获取最新数据 — 帖子、粉丝、头像等。根据您的网络连接和 Instagram 服务器负载，这需要 2–5 秒。完全正常：这与真实 Instagram 应用在慢速连接下的延迟完全相同。";
"faq.q.slow_load.tip" = "舞台小贴士：如果观众注意到加载，趁加载时说\"让我打开 Instagram\" — 他们会认为这是正常的网络延迟，事实也确实如此。";

"faq.q.refresh.question" = "每次打开 Performance 时个人资料都会刷新吗？";
"faq.q.refresh.answer" = "是的，每次会话刷新一次。应用从 Instagram 获取最新数据并缓存，以保持内容准确。如果您在同一 90 秒窗口内再次打开 Performance，缓存版本会立即显示 — 无需新请求。";

"faq.q.new_photo.question" = "我在 Instagram 上传了新照片。什么时候会出现？";
"faq.q.new_photo.answer" = "下次打开 Performance 时会出现新照片 — 通常在 Instagram 发布后 90 秒内。应用总会在进入时获取最新帖子，无需手动操作。";

"faq.q.reels_slow.question" = "Reels 和被标记的内容加载很慢。正常吗？";
"faq.q.reels_slow.answer" = "Reels 和被标记的照片会在帖子出现后几秒钟在后台自动加载，在您滑动到这些标签之前就已准备好。加载后会保存，以后打开时即时显示 — 无需网络。";

"faq.q.no_data.question" = "打开 Performance 时没有网络连接会怎样？";
"faq.q.no_data.answer" = "个人资料的最新保存版本会立即从缓存中显示 — 帖子、头像、计数器一切都有。网络恢复后应用会悄悄尝试刷新，但即使离线您也可以不间断地演示。";

"faq.q.bot.question" = "使用 Vault 会导致 Instagram 账号被封吗？";
"faq.q.bot.answer" = "Vault 的设计充分考虑了 Instagram 的限制。它自动分散请求、遵守冷却时间，从不发送批量操作。正常使用下风险极小。避免在极短时间内连续执行数十个技巧 — 应用已自动防止这种情况。";

"faq.q.not_instagram.question" = "观众问为什么应用看起来像 Instagram。我怎么回答？";
"faq.q.not_instagram.answer" = "Performance 是您 Instagram 个人资料的忠实视觉副本 — 相同的布局、相同的照片、相同的计数器。如果有人问，您可以简单地说正在查看自己的 Instagram，因为显示的数据是真实的，直接来自您的账号。";

"upload.tip.title" = "可以让它继续上传";
"upload.tip.overnight" = "上传进行中，屏幕将保持常亮 — 手机绝不会锁屏或进入休眠。插上电源，整夜运行，无需触碰即可轻松填满 10 个以上的 Bank。";
"upload.tip.background" = "想正常使用手机？随时切换到其他 App 即可。当下一张照片准备好上传时，弹窗提醒会带您回到此界面。";


