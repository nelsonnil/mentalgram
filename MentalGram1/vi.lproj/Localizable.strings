"set.input.label" = "Nhập";
"set.input.configure" = "Cấu hình";
"set.input.covertyping.help" = "Che những gì bạn gõ trong Khám phá để khán giả thấy một từ khác. Nhấn PHÍM CÁCH để tiết lộ.";
"set.input.covertyping.maskmode" = "Chế độ mặt nạ";
