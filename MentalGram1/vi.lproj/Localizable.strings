"perf.help.overview.title" = "Trình diễn là gì?";
"perf.help.plus.title" = "Nút + — Truy cập Cài đặt";
"perf.help.profile.title" = "Chế độ xem hồ sơ";
"perf.help.bottombar.title" = "Thanh điều hướng dưới";
"perf.help.explore.title" = "Explore";
"perf.help.realdata.title" = "Dữ liệu Instagram thật";
"perf.help.overview.body1" = "Trình diễn là trình giả lập Instagram tích hợp. Trông và cảm giác như ứng dụng Instagram thật, nhưng chạy bên trong Vault và được kết nối trực tiếp với tài khoản Instagram của bạn thông qua API chính thức.";
"perf.help.overview.infobox" = "Mọi thứ khán giả thấy là nội dung Instagram thật từ tài khoản thực của bạn — bài viết, người theo dõi, reels — được lấy trực tiếp từ API. Đây không phải mô phỏng; đây là hồ sơ thật của bạn.";
"perf.help.overview.body2" = "Khán giả có thể cầm điện thoại của bạn, mở bất kỳ hồ sơ nào, cuộn tự do và xem dữ liệu Instagram thật mọi lúc. Vault hoạt động vô hình ở nền.";
"perf.help.plus.body" = "Để truy cập Cài đặt từ Trình diễn, nhấn nút + ở góc trên bên trái thanh tiêu đề — cùng thanh hiển thị tên người dùng ở giữa. Đây là cách duy nhất quay lại Cài đặt khi đang ở chế độ Trình diễn.";
"perf.help.plus.infobox" = "Cài đặt tất cả thủ thuật (Ép bài viết, Ép Reel, Ép ngày, Counter Glitch, v.v.) trong Cài đặt trước buổi diễn. Khi vào Trình diễn, dùng nút + để quay lại và điều chỉnh nếu cần.";
"perf.help.plus.mock.label" = "Thanh tiêu đề";
"perf.help.plus.mock.sublabel" = "Nhấn + (trên cùng bên trái) để mở Cài đặt";
"perf.help.profile.followers.title" = "Số người theo dõi — có thể nhấn";
"perf.help.profile.followers.desc" = "Nhấn số người theo dõi để mở danh sách người theo dõi đầy đủ. Trong chế độ Ép ngày, nhấn vòng tròn avatar để chọn khán giả — huy hiệu số xanh hiển thị thứ tự chọn (1, 2, 3…). Nửa đầu = nhóm ngày, nửa sau = nhóm giờ. Nhấn ngoài vòng tròn để mở hồ sơ người đó.";
"perf.help.profile.tabs.title" = "Tab Bài viết / Reels / Được gắn thẻ";
"perf.help.profile.tabs.desc" = "Chuyển đổi giữa ba tab để duyệt bài viết, reels và ảnh được gắn thẻ của hồ sơ. Nhấn bất kỳ hình thu nhỏ nào để xem toàn màn hình.";
"perf.help.profile.refresh.title" = "Kéo để làm mới";
"perf.help.profile.refresh.desc" = "Kéo xuống trên hồ sơ để tải lại từ Instagram và hiển thị mọi thay đổi gần đây (người theo dõi mới, tiểu sử đã cập nhật, ảnh mới tải lên).";
"perf.help.bottombar.body" = "Thanh điều hướng dưới bắt chước giao diện Instagram. Hầu hết các nút là trang trí — chỉ kính lúp (Tìm kiếm) là chức năng và mở Explore.";
"perf.help.bottombar.infobox" = "Nút Tìm kiếm/kính lúp là cách chính để điều hướng đến Explore. Nhấn để duyệt reels ngẫu nhiên và tìm kiếm bất kỳ hồ sơ Instagram nào theo tên người dùng.";
"perf.help.mock.home" = "Trang chủ";
"perf.help.mock.search" = "Tìm kiếm";
"perf.help.mock.send" = "Gửi";
"perf.help.mock.profile" = "Hồ sơ";
"perf.help.mock.active" = "✓ Đang dùng";
"perf.help.mock.posts" = "Bài viết";
"perf.help.mock.reels" = "Reels";
"perf.help.mock.tagged" = "Được gắn thẻ";
"perf.help.explore.body" = "Chế độ xem Explore mở khi bạn nhấn kính lúp trong thanh dưới. Nó hiển thị nguồn cấp Explore Instagram thật với reels ngẫu nhiên và thanh tìm kiếm ở trên cùng để tìm bất kỳ hồ sơ nào.";
"perf.help.explore.reels.title" = "Nguồn cấp reels ngẫu nhiên";
"perf.help.explore.reels.desc" = "Explore hiển thị reels thật từ Instagram. Khán giả có thể cuộn tự do. Trong chế độ Ép Reel, reel mục tiêu xuất hiện ở vị trí bạn đã quay bí mật.";
"perf.help.explore.search.title" = "Tìm kiếm bất kỳ hồ sơ thật nào";
"perf.help.explore.search.desc" = "Nhập bất kỳ tên người dùng nào trong thanh tìm kiếm để tải hồ sơ Instagram thật của họ — ảnh, người theo dõi, đang theo dõi — trực tiếp từ API. Khán giả có thể tự do chọn xem ai.";
"perf.help.explore.infobox" = "Trong chế độ Ép Reel, tìm kiếm và vuốt giữa các tab (Bài viết/Reels/Được gắn thẻ) trên hồ sơ bí mật đăng ký mỗi chữ số của số khán giả. Khi bạn mở Explore, reel xuất hiện đúng ở vị trí đó.";
"perf.help.realdata.body" = "Vì Trình diễn được kết nối với API Instagram thật, tất cả dữ liệu bạn thấy là xác thực và hiện tại. Không có nội dung được tải sẵn.";
"perf.help.realdata.item1" = "Ảnh và video được tải trực tiếp từ tài khoản Instagram thật của bạn";
"perf.help.realdata.item2" = "Số lượng người theo dõi và đang theo dõi là thật — và có thể được thao tác bí mật cho các hiệu ứng";
"perf.help.realdata.item3" = "Bất kỳ hồ sơ nào bạn tìm kiếm đều tải bài viết, reels và tiểu sử thật từ API";
"perf.help.realdata.item4" = "Cập nhật tiểu sử và tải ảnh lên được thực hiện từ Cài đặt xuất hiện trên hồ sơ Instagram thật";

"limits.help.title" = "Giới hạn & An toàn";
"limits.help.calm.title" = "Thư giãn — mọi thứ đều trong tầm kiểm soát";
"limits.help.calm.body" = "Instagram thỉnh thoảng hiển thị cảnh báo ngắn yêu cầu xác nhận đó là bạn. Điều này hoàn toàn bình thường với bất kỳ ứng dụng nào kết nối với nền tảng và không liên quan đến lệnh cấm. Vault được thiết kế với các biện pháp bảo vệ chống bot giống các ứng dụng thật sử dụng, và mỗi biện pháp đều được kiểm tra rộng rãi.";
"limits.help.calm.infobox" = "Tôi cá nhân đã kích hoạt loại cảnh báo này hơn 100 lần trong quá trình phát triển và tài khoản của tôi chưa bao giờ bị cấm. Các ứng dụng khác với cùng phương pháp hoạt động bình thường — nếu có rủi ro thật sự, Vault sẽ không được xuất bản.";
"limits.help.budget.title" = "Những gì dùng ngân sách theo giờ của bạn";
"limits.help.budget.intro" = "Instagram cho phép khoảng 55 hành động API mỗi giờ mỗi phiên. Ứng dụng theo dõi điều này tự động. Đây là những gì được tính — và những gì không:";
"limits.help.budget.free" = "MIỄN PHÍ";
"limits.help.budget.free.items" = "Cuộn lưới · Hoạt ảnh nút âm lượng · Nhập số bí mật · Xem hồ sơ đã mở (cache) · Duyệt Cài đặt hoặc Hướng dẫn";
"limits.help.budget.low" = "THẤP";
"limits.help.budget.low.items" = "Mở ứng dụng (1) · Tải danh sách người theo dõi (1) · Tiết lộ một chữ cái/ảnh (1 mỗi cái) · Counter Glitch — lần đầu mở hồ sơ mới (4) · Tìm kiếm hồ sơ (2)";
"limits.help.budget.high" = "CAO";
"limits.help.budget.high.items" = "Đồng bộ & Lưu trữ — 2 cuộc gọi mỗi ảnh · Tải ảnh lên — 1 cuộc gọi mỗi ảnh · Mở 5 hồ sơ người theo dõi khác nhau — ~20 cuộc gọi";
"limits.help.budget.reset" = "Ngân sách đặt lại mỗi 60 phút. Nếu ứng dụng tự tạm dừng, có nghĩa bạn đã dùng hết hạn mức theo giờ — chỉ cần chờ và nó tự tiếp tục.";
"limits.help.rehearsal.title" = "Tập luyện an toàn — quy tắc vàng";
"limits.help.rehearsal.body" = "Hầu hết các phát hiện bot xảy ra trong khi kiểm tra, không phải trong buổi diễn. Một vài thói quen đơn giản loại bỏ 90% rủi ro:";
"limits.help.rehearsal.tip1" = "Mở hồ sơ người theo dõi một lần → được cache nhiều ngày. Tập Counter Glitch bao nhiêu lần tùy thích với cùng người đó ở chi phí bằng không.";
"limits.help.rehearsal.tip2" = "Trải rộng Đồng bộ & Lưu trữ và tải ảnh lên trong các giờ khác nhau — đừng gộp tất cả trước buổi diễn.";
"limits.help.rehearsal.avoid1" = "Đừng mở 4–5 hồ sơ người theo dõi khác nhau liên tiếp khi tập. Mỗi hồ sơ mới tốn ~4 cuộc gọi API.";
"limits.help.rehearsal.avoid2" = "Đừng khởi động lại ứng dụng nhiều lần khi kiểm tra — mỗi lần khởi động lại kích hoạt kiểm tra phiên.";
"limits.help.rehearsal.tip" = "Tập luyện an toàn nhất: mở đúng người theo dõi bạn sẽ dùng, thực hiện hiệu ứng một lần, quay lại. Lặp lại cùng trình tự đó → hoàn toàn miễn phí từ lần thứ hai trở đi.";
"limits.help.warning.title" = "Nếu bạn thấy cảnh báo \"Hoạt động bất thường\"";
"limits.help.warning.intro" = "Đừng lo — đây không phải lệnh cấm. Đây chỉ là Instagram xác nhận thực sự là bạn. Làm theo các bước sau:";
"limits.help.warning.step1" = "Mở ứng dụng Instagram chính thức và nhấn \"Bỏ qua\" trên cảnh báo.";
"limits.help.warning.step2" = "Nếu yêu cầu xác minh, hoàn thành bằng email hoặc mã SMS.";
"limits.help.warning.step3" = "Trong Vault, đăng xuất từ Cài đặt, chờ khoảng một phút, và đăng nhập lại.";
"limits.help.warning.step4" = "Bạn đã sẵn sàng tiếp tục — tài khoản của bạn an toàn.";
"limits.help.warning.reassure" = "Tài khoản của bạn tiếp tục hoạt động hoàn hảo. Điều này chỉ tạm dừng Vault trong vài phút, không hơn.";
"limits.help.show.title" = "Trong buổi diễn trực tiếp";
"limits.help.show.body" = "Nếu cảnh báo xuất hiện khi khán giả đang nhìn màn hình, Vault ẩn tất cả chi tiết kỹ thuật và hiển thị màn hình chung \"Không có kết nối Internet\".";
"limits.help.show.infobox" = "Bìa hoàn hảo: \"Ugh, Instagram đang bị lỗi một chút — không sao.\". Không khán giả nào sẽ thấy bất cứ điều gì kỹ thuật.";
"limits.help.best.title" = "Thực hành tốt nhất";
"limits.help.best.item1" = "Đừng lặp lại cùng hiệu ứng nhiều lần liên tiếp trong cùng phiên — thuật toán có thể gắn cờ là tự động.";
"limits.help.best.item2" = "Chuẩn bị bộ (Đồng bộ & Lưu trữ) vào tối hôm trước hoặc ít nhất một giờ trước buổi diễn, không phải ngay sau khi tập.";
"limits.help.best.item3" = "Nếu bạn biểu diễn thường xuyên, hãy dùng tài khoản Instagram riêng biệt với tài khoản chính.";
"limits.help.best.item4" = "Vault tự động xử lý tất cả thời gian chờ — bạn không cần nghĩ về bất kỳ điều gì.";
"limits.help.testing.title" = "Tại sao Instagram có thể yêu cầu kiểm tra bảo mật?";
"limits.help.testing.body" = "Trong quá trình kiểm tra ứng dụng, Instagram thường phát hiện hoạt động bất thường. Khi kiểm tra, nhiều hành động được thực hiện nhanh chóng liên tiếp — thay đổi tiểu sử, ghi chú, tiết lộ ảnh — trong thời gian ngắn trên tài khoản mới, điều này có thể trông như hành vi tự động với hệ thống bảo mật của Instagram.\n\nTrong buổi biểu diễn thực tế điều này không bao giờ xảy ra: các hành động tự nhiên được ngăn cách bởi thời gian của chính màn diễn, điều này làm cho mọi thứ trông như sử dụng con người bình thường.";
"limits.help.testing.fix" = "Nếu Instagram yêu cầu xác minh email hoặc số điện thoại, đó chỉ là kiểm tra bảo mật một lần. Hoàn thành từ trình duyệt tại instagram.com và tài khoản của bạn sẽ hoạt động bình thường trở lại.";
"limits.help.session.title" = "Nếu ứng dụng hiển thị màn hình \"Không có Internet\"";
"limits.help.session.body" = "Đôi khi Instagram tạm thời thu hồi phiên — ứng dụng sau đó hiển thị màn hình chung \"Không có kết nối Internet\" để khán giả không thấy gì kỹ thuật. Đây không phải lệnh cấm.\n\nĐể xem giải thích thật và khắc phục, nhấn nút ⓘ ở góc dưới bên phải màn hình đó.";
"limits.help.session.case1.label" = "Chỉ xuất hiện nút Bỏ qua";
"limits.help.session.case1.action" = "Nhấn Bỏ qua trong ứng dụng Instagram, rồi quay thẳng lại đây và nhấn Đăng nhập lại. Không cần chờ — bạn sẽ vào ngay.";
"limits.help.session.case2.label" = "Hiển thị ngày kết thúc cụ thể";
"limits.help.session.case2.action" = "Chờ đến ngày đó, rồi đăng nhập lại. Instagram đang áp dụng thời gian chờ ngắn — tài khoản của bạn ổn.";
"limits.help.session.case3.label" = "Yêu cầu mã điện thoại hoặc email";
"limits.help.session.case3.action" = "Hoàn thành xác minh trong ứng dụng Instagram trước. Khi xong, quay lại đây và nhấn Đăng nhập lại.";
"limits.help.session.new_account" = "Tài khoản mới với ít lịch sử hoạt động có nhiều khả năng gặp điều này hơn. Tích lũy bài viết, người theo dõi và tương tác dần dần — Instagram tin tưởng các tài khoản có vẻ đã được thiết lập nhiều hơn.";
"limits.help.session.contact" = "Nếu phát hiện bot tiếp tục xảy ra, liên hệ nhà phát triển và chia sẻ nhật ký của bạn (Cài đặt → Xuất nhật ký). Điều này giúp phân tích vấn đề và cải thiện bảo vệ cho mọi người.";
"limits.help.gauge.title" = "Ngân sách 55 hành động theo giờ của bạn";
"limits.help.gauge.body" = "Instagram giới hạn mỗi ứng dụng kết nối ở 55 hành động mỗi giờ. Ngân sách hoạt động như cửa sổ 60 phút liên tục — mỗi hành động hết hạn đúng 60 phút sau khi thực hiện, vì vậy bộ đếm giảm tự động theo thời gian mà không cần đặt lại cứng.";
"limits.help.gauge.cache" = "Mở Performance từ lần thứ hai trở đi tốn 0 — tất cả được lưu vĩnh viễn trên thiết bị. Chỉ lần đầu tiên (hoặc sau khi đổi tài khoản) mới dùng 3–5 hành động để tải và lưu toàn bộ hồ sơ.";
"limits.help.gauge.hardstop" = "Khi đạt giới hạn 55, ứng dụng tự động ngừng thực hiện bất kỳ yêu cầu Instagram nào nữa. Không có gì được gửi, không có gì được kích hoạt — nó chờ âm thầm cho đến khi ngân sách gia hạn. Bạn không cần làm gì.";
"limits.help.gauge.zone.safe" = "An toàn (>20)";
"limits.help.gauge.zone.low" = "Thấp (8–20)";
"limits.help.gauge.zone.critical" = "Nguy cấp (<8)";
"limits.help.table.title" = "Hành động tiêu thụ mỗi tính năng";
"limits.help.table.subtitle" = "Chi phí lần đầu sử dụng so với khi kết quả đã được cache.";
"limits.help.table.col.action" = "Tính năng";
"limits.help.table.col.first" = "Lần đầu";
"limits.help.table.col.again" = "Lặp lại";
"limits.help.table.row.performance" = "Mở Trình diễn (hồ sơ + bộ nhớ đệm nền)";
"limits.help.table.row.followers" = "Danh sách người theo dõi";
"limits.help.table.row.profile.new" = "Hồ sơ người theo dõi mới";
"limits.help.table.row.profilepic" = "Đổi ảnh hồ sơ";
"limits.help.table.row.sa" = "Đồng bộ & Lưu trữ (mỗi ảnh)";
"limits.help.table.row.upload" = "Tải lên (mỗi ảnh)";
"limits.help.table.row.autoupload" = "Tự động tải lên mỗi ảnh (tải + lưu trữ)";
"limits.help.table.row.reveal" = "Tiết lộ (mỗi chữ cái/ảnh)";
"limits.help.table.row.notebio" = "Thay đổi ghi chú hoặc tiểu sử";
"limits.help.table.row.explore" = "Explore / Tìm kiếm";
"limits.help.sa.auto" = "Sau buổi diễn đầy đủ với tiết lộ và truy cập hồ sơ, ứng dụng tự động thêm thời gian chờ ngắn trước Đồng bộ & Lưu trữ. Điều này bình thường — nó bảo vệ phiên của bạn.";
"limits.help.table.cache.lost" = "Sau lần tải đầu tiên, Performance được lưu đầy đủ trên thiết bị — mỗi lần vào sau đó tốn 0 hành động. Lần đầu (hoặc sau khi đổi tài khoản) hiển thị màn hình tải trong khi hồ sơ được tải xuống và lưu. Nhấn Làm mới trong Cài đặt chỉ khi bạn đã thay đổi gì đó trên Instagram thật (bài đăng mới, sửa bio, v.v.).";
"limits.help.table.batch.note" = "Chi phí theo ảnh sẽ cộng dồn. Sync & Archive trên 4 ảnh = tổng 8 hành động. Tải 4 ảnh lên = tổng 9 (1 lệnh chuẩn bị + 2 mỗi ảnh). Ảnh hồ sơ hiển thị 1 hành động ngân sách, dù Instagram cũng nhận lệnh tải ảnh lên.";
"limits.help.profiles.title" = "Truy cập hồ sơ — hành động tốn kém nhất";
"limits.help.profiles.body" = "Mở hồ sơ người theo dõi mới thường tốn 3–4 hành động. Lần truy cập lại nhanh cùng hồ sơ tải từ cache, nhưng lần làm mới sau đó có thể dùng ngân sách lại. Đây là lý do tại sao mở 3–4 hồ sơ khác nhau nhanh chóng có thể cạn kiệt ngân sách và kích hoạt phát hiện bot.";
"limits.help.profiles.max" = "Khuyến nghị: mở tối đa 2 hồ sơ mới mỗi phiên. Tránh truy cập hồ sơ mới ngay trước Đồng bộ & Lưu trữ.";
"limits.help.reddot.title" = "Chấm đỏ";
"limits.help.reddot.body" = "Khi còn ít hơn 8 hành động, một chấm đỏ nhỏ xuất hiện trên các biểu tượng điều khiển riêng tư như tiêu đề danh sách người theo dõi hoặc máy bay giấy trong Trình diễn. Nó cảnh báo bạn trước khi dùng thêm ngân sách.";
"limits.help.reddot.block" = "Nếu bạn cố mở hồ sơ mới khi ngân sách ở mức nguy cấp, ứng dụng dừng hành động với rung mạnh. Không có cuộc gọi API nào được thực hiện — phiên của bạn vẫn an toàn.";
"limits.help.reddot.location.followers" = "Danh sách người theo dõi";
"limits.help.reddot.location.performance" = "Biểu tượng máy bay giấy (Trình diễn)";
"limits.help.noban.title" = "Tài khoản của bạn sẽ không bao giờ bị cấm.";
"limits.help.noban.body" = "Instagram thỉnh thoảng yêu cầu xác nhận danh tính — chỉ vậy thôi. Đây không phải lệnh cấm, không phải cảnh báo và không phải rủi ro cho tài khoản của bạn. Vault đã được kiểm tra với hàng trăm tài khoản Instagram thật và không một tài khoản nào bị cấm hoặc bị hạn chế vĩnh viễn. Nếu xuất hiện popup, làm theo các bước trên và bạn sẽ trở lại trong vòng chưa đầy một phút.";
"limits.help.continue.button" = "Tôi hiểu — mở Trình diễn";

"notif.archive_ready.title" = "Sẵn sàng lưu trữ";
"notif.archive_ready.body" = "Bây giờ bạn có thể lưu trữ ảnh một cách an toàn.";

"dfh.section.audience_title" = "Hiểu khán giả của bạn";
"dfh.audience.intro" = "Trước khi chọn người tham gia, ứng dụng tự động hiển thị ai có hồ sơ công khai và ai có hồ sơ riêng tư — không cần thêm cuộc gọi API.";
"dfh.audience.badge_public" = "Hồ sơ công khai";
"dfh.audience.badge_private" = "Hồ sơ riêng tư";
"dfh.audience.badge_note" = "\"Theo dõi lại\" màu xanh = tài khoản riêng tư. Người theo dõi/đang theo dõi của họ có thể truy cập — bạn có thể dùng cho hiệu ứng Ép ngày.";
"dfh.audience.strategy_a.title" = "Khán giả lớn (4+ người)";
"dfh.audience.strategy_a.option1" = "Hỏi ai có hồ sơ công khai và hướng dẫn họ theo dõi bạn. Với nhóm 10+ người, luôn có ít nhất 4 người có hồ sơ công khai.";
"dfh.audience.strategy_a.option2" = "Để mọi người theo dõi bạn. Khi bạn mở danh sách người theo dõi, ứng dụng đánh dấu tài khoản riêng tư bằng \"Theo dõi lại\" — chỉ cần chọn những người công khai.";
"dfh.audience.strategy_b.title" = "Khán giả nhỏ hoặc tất cả riêng tư";
"dfh.audience.strategy_b.body" = "Nếu khán giả nhỏ và tất cả đều có hồ sơ riêng tư: yêu cầu họ theo dõi bạn từ Instagram thật, chấp nhận yêu cầu, rồi chuyển từ Instagram sang Vault và chọn người tham gia từ danh sách người theo dõi.";
"dfh.tip.private_accounts" = "Tài khoản riêng tư được phát hiện tự động. Nhãn \"Theo dõi lại\" màu xanh cho biết tài khoản riêng tư. Xem phần \"Hiểu khán giả\" để biết chiến lược đầy đủ.";
"dfh.mockup.followers_tab" = "Người theo dõi";
"dfh.mockup.following_tab" = "Đang theo dõi";
"dfh.mockup.follow_too" = "Theo dõi lại";
"dfh.mockup.remove_btn" = "Xóa";

