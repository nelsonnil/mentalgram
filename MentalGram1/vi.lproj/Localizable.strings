"guide.section.camouflage" = "NGỤY TRANG";
"guide.fakehome.title" = "Màn hình chủ giả";
"guide.fakehome.subtitle" = "Hiển thị ảnh chụp màn hình chủ khi mở Trình diễn";
"guide.fakehome.help.what.title" = "Màn hình chủ giả là gì?";
"guide.fakehome.help.what.body" = "Khi bạn mở Trình diễn, thay vì đi thẳng đến hồ sơ, ứng dụng đầu tiên hiển thị ảnh chụp màn hình chủ iPhone thật của bạn. Với người xem, trông như bạn vừa mở ứng dụng Instagram bình thường.";
"guide.fakehome.help.how.title" = "Cách sử dụng";
"guide.fakehome.help.how.body" = "1. Chụp ảnh màn hình thật của màn hình chính iPhone, đảm bảo biểu tượng Instagram hiển thị.

2. Tải lên trong Cài đặt › Dữ liệu › Fake Home Screen.

3. Sau khi ảnh chụp màn hình được tải, màn hình chính giả sẽ tự động kích hoạt. Lần sau khi bạn mở Performance, nó hiển thị toàn màn hình — chạm vào bất kỳ đâu (tốt nhất là ngay trên biểu tượng Instagram) để hiển thị hồ sơ của bạn.";
"guide.fakehome.help.why.title" = "Tại sao dùng nó?";
"guide.fakehome.help.why.body" = "Nó tạo ảo giác rằng bạn chỉ đơn giản đang mở ứng dụng Instagram thật. Bất kỳ ai nhìn vào màn hình chỉ thấy màn hình chủ bình thường trước khi hồ sơ của bạn xuất hiện, làm cho trải nghiệm trông hoàn toàn tự nhiên.";

"guide.lockscreen.title" = "Nhập từ màn hình khóa";
"guide.lockscreen.subtitle" = "Màn hình khóa iOS giả để nhập chữ số bí mật";
"guide.lockscreen.help.what.title" = "Nhập màn hình khóa là gì?";
"guide.lockscreen.help.what.body" = "Khi bạn mở Trình diễn, ứng dụng hiển thị màn hình mã iOS giả trước khi hiện hồ sơ. Với bất kỳ ai xem trông như bạn đang mở khóa điện thoại bình thường.";
"guide.lockscreen.help.how.title" = "Cách nhập số bí mật";
"guide.lockscreen.help.how.body" = "1. Nhấn các chữ số của số bí mật trên bàn phím — chúng đăng ký âm thầm.\n\n2. Nhấn bất kỳ đâu ngoài bàn phím để khóa các chữ số đó lại.\n\n3. Điền các chấm còn lại bằng cách nhấn bất kỳ chữ số nào — chúng bị bỏ qua.\n\n4. Khi tất cả 4 chấm được điền, màn hình khóa đóng và Trình diễn mở.";
"guide.lockscreen.help.wallpaper.title" = "Hình nền";
"guide.lockscreen.help.wallpaper.body" = "Tải lên cùng hình nền bạn dùng trên màn hình khóa thật để màn hình giả trông giống hệt. Sau đó chọn **Màn hình khóa** làm phương thức nhập trên thẻ set của bạn trong My Sets.";
"guide.lockscreen.help.why.title" = "Tại sao dùng nó?";
"guide.lockscreen.help.why.body" = "Nó che giấu việc nhập số bí mật như việc mở khóa điện thoại bình thường. Kết hợp với Màn hình chủ giả, toàn bộ trình tự trông như: mở khóa điện thoại → màn hình chủ → mở Instagram — hoàn toàn tự nhiên với bất kỳ người xem nào.";
"guide.lockscreen.help.tricks.title" = "Cùng số bí mật — nhiều thủ thuật";
"guide.lockscreen.help.tricks.body" = "Số bạn nhập ở đây là số bí mật tương tự được dùng bởi Nhập lưới và tất cả thủ thuật ảo thuật khác. Với nó bạn có thể kích hoạt:\n\n• Bỏ lưu trữ ảnh từ bộ số\n• Tiết lộ bài bài\n• Hiện ảnh tùy chỉnh\n• Kích hoạt counter glitch\n• Ép Reel trong Explore";
"guide.lockscreen.help.cards.title" = "Mã bài";
"guide.lockscreen.help.cards.body" = "Để tiết lộ một lá bài, nhập mã của nó làm số bí mật:\n\nChất:  1 = ♠   2 = ♥   3 = ♣   4 = ♦\n\nBài A–9  →  [giá trị][chất]\n  A♠ = 11    7♥ = 72    9♦ = 94\n\nBài 10, J, Q, K  →  [hàng chục][hàng đơn vị][chất]\n  10♠ = 101    J♥ = 112\n  Q♣  = 123    K♦  = 134\n\nVí dụ: để tiết lộ Q♥ nhập 122.";

"guide.faq.section" = "CÂU HỎI THƯỜNG GẶP";
"guide.faq.row.title" = "Câu hỏi thường gặp";
"guide.faq.row.subtitle" = "Hành vi bình thường được giải thích bằng ngôn ngữ đơn giản — tải, làm mới và hơn thế";
"faq.help.title" = "Câu hỏi thường gặp";
"faq.q.slow_load.question" = "Tại sao hồ sơ mất vài giây để tải?";
"faq.q.slow_load.answer" = "Khi bạn mở Trình diễn, ứng dụng kết nối với Instagram để lấy dữ liệu mới nhất — bài viết, người theo dõi, ảnh hồ sơ và hơn thế. Điều này mất 2–5 giây tùy thuộc kết nối internet và máy chủ Instagram. Không có gì sai: đây chính xác là độ trễ giống ứng dụng Instagram thật khi kết nối chậm.";
"faq.q.slow_load.tip" = "Mẹo sân khấu: nếu khán giả chú ý đến loading, hãy nói \"để tôi mở Instagram\" trong khi tải — họ sẽ cho rằng đó là độ trễ mạng bình thường, điều đó hoàn toàn đúng.";
"faq.q.refresh.question" = "Hồ sơ có làm mới mỗi lần tôi mở Trình diễn không?";
"faq.q.refresh.answer" = "Có, một lần mỗi phiên. Ứng dụng lấy dữ liệu mới từ Instagram và lưu vào bộ nhớ để nội dung luôn chính xác. Nếu bạn mở Trình diễn lại trong cùng khoảng 90 giây, phiên bản cache xuất hiện ngay lập tức — không có yêu cầu mới nào được thực hiện.";
"faq.q.new_photo.question" = "Tôi đã tải ảnh mới lên Instagram. Khi nào nó xuất hiện?";
"faq.q.new_photo.answer" = "Ảnh mới của bạn sẽ xuất hiện lần tới khi bạn mở Trình diễn — thường trong vòng 90 giây sau khi đăng lên Instagram. Ứng dụng luôn lấy bài viết mới nhất khi vào, vì vậy bạn không cần làm gì thủ công.";
"faq.q.reels_slow.question" = "Reels và nội dung Tagged có vẻ chậm xuất hiện. Có bình thường không?";
"faq.q.reels_slow.answer" = "Reels và ảnh Tagged tải tự động ở nền vài giây sau khi bài viết của bạn xuất hiện, vì vậy chúng đã sẵn sàng trước khi bạn vuốt sang các tab đó. Sau khi tải chúng được lưu và xuất hiện ngay lập tức trong các phiên sau — không cần internet.";
"faq.q.no_data.question" = "Điều gì xảy ra nếu tôi không có kết nối internet khi mở Trình diễn?";
"faq.q.no_data.answer" = "Phiên bản lưu cuối cùng của hồ sơ được hiển thị ngay lập tức từ cache — bài viết, ảnh hồ sơ, bộ đếm người theo dõi và tất cả. Ứng dụng sẽ âm thầm cố làm mới khi kết nối trở lại, nhưng bạn có thể biểu diễn mà không bị gián đoạn ngay cả khi offline.";
"faq.q.bot.question" = "Sử dụng Vault có thể bị đình chỉ tài khoản Instagram không?";
"faq.q.bot.answer" = "Vault được thiết kế với giới hạn của Instagram trong đầu. Nó tự động giãn cách các yêu cầu, tôn trọng thời gian chờ và không bao giờ gửi hành động hàng loạt. Trong sử dụng bình thường rủi ro là tối thiểu. Tránh thực hiện hàng chục thủ thuật liên tiếp trong thời gian rất ngắn — ứng dụng đã tự ngăn điều này.";
"faq.q.not_instagram.question" = "Khán giả hỏi tại sao ứng dụng trông như Instagram. Tôi nói gì?";
"faq.q.not_instagram.answer" = "Trình diễn là bản sao hình ảnh trung thực của hồ sơ Instagram của bạn — cùng bố cục, cùng ảnh, cùng số liệu. Nếu ai hỏi, bạn có thể nói bạn đang kiểm tra Instagram, vì dữ liệu hiển thị là thật và trực tiếp từ tài khoản của bạn.";

