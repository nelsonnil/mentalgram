"guide.faq.section" = "FAQ";
"guide.faq.row.title" = "常見問題";
"guide.faq.row.subtitle" = "用簡單語言解釋正常行為 — 載入、重新整理等";
"faq.help.title" = "常見問題";

"faq.q.slow_load.question" = "為什麼我的個人資料載入需要幾秒鐘？";
"faq.q.slow_load.answer" = "開啟 Performance 時，應用程式會連線到 Instagram 取得最新資料 — 貼文、追蹤者、大頭照等。根據您的網路連線和 Instagram 伺服器負載，這需要 2–5 秒。完全正常：這與真實 Instagram 應用程式在慢速連線下的延遲完全相同。";
"faq.q.slow_load.tip" = "舞台小提示：如果觀眾注意到載入，趁載入時說「讓我開啟 Instagram」— 他們會認為這是正常的網路延遲，事實也確實如此。";

"faq.q.refresh.question" = "每次開啟 Performance 時個人資料都會重新整理嗎？";
"faq.q.refresh.answer" = "是的，每次工作階段重新整理一次。應用程式從 Instagram 取得最新資料並快取，以保持內容準確。如果您在同一 90 秒視窗內再次開啟 Performance，快取版本會立即顯示 — 無需新請求。";

"faq.q.new_photo.question" = "我在 Instagram 上傳了新照片。什麼時候會出現？";
"faq.q.new_photo.answer" = "下次開啟 Performance 時會出現新照片 — 通常在 Instagram 發布後 90 秒內。應用程式總會在進入時取得最新貼文，無需手動操作。";

"faq.q.reels_slow.question" = "Reels 和被標記的內容載入很慢。正常嗎？";
"faq.q.reels_slow.answer" = "Reels 和被標記的照片會在貼文出現後幾秒鐘在背景自動載入，在您滑動到這些分頁之前就已準備好。載入後會儲存，之後開啟時即時顯示 — 無需網路。";

"faq.q.no_data.question" = "開啟 Performance 時沒有網路連線會怎樣？";
"faq.q.no_data.answer" = "個人資料的最新儲存版本會立即從快取中顯示 — 貼文、大頭照、計數器一切都有。網路恢復後應用程式會悄悄嘗試重新整理，但即使離線您也可以不間斷地演示。";

"faq.q.bot.question" = "使用 Vault 會導致 Instagram 帳號被封嗎？";
"faq.q.bot.answer" = "Vault 的設計充分考慮了 Instagram 的限制。它自動分散請求、遵守冷卻時間，從不傳送批次操作。正常使用下風險極小。避免在極短時間內連續執行數十個技巧 — 應用程式已自動防止這種情況。";

"faq.q.not_instagram.question" = "觀眾問為什麼應用程式看起來像 Instagram。我怎麼回答？";
"faq.q.not_instagram.answer" = "Performance 是您 Instagram 個人資料的忠實視覺副本 — 相同的版面配置、相同的照片、相同的計數器。如果有人問，您可以簡單地說正在查看自己的 Instagram，因為顯示的資料是真實的，直接來自您的帳號。";

"upload.tip.title" = "上傳技巧";
