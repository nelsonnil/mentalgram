// MARK: - FAQ Help View
"guide.faq.section" = "FAQ";
"guide.faq.row.title" = "Часто задаваемые вопросы";
"guide.faq.row.subtitle" = "Нормальное поведение простым языком — загрузка, обновление и другое";
"faq.help.title" = "Часто задаваемые вопросы";

"faq.q.slow_load.question" = "Почему профиль загружается несколько секунд?";
"faq.q.slow_load.answer" = "При открытии Performance приложение подключается к Instagram для получения актуальных данных — публикаций, подписчиков, фото профиля и многого другого. Это занимает 2–5 секунд в зависимости от скорости интернета и нагрузки серверов Instagram. Никакой ошибки нет: это точно такая же задержка, которая была бы в настоящем приложении Instagram при медленном соединении.";
"faq.q.slow_load.tip" = "Совет для выступления: если зрители заметят загрузку, скажите «дайте открою Instagram» пока идёт загрузка — они решат, что это обычная задержка сети, что является правдой.";

"faq.q.refresh.question" = "Профиль обновляется каждый раз при открытии Performance?";
"faq.q.refresh.answer" = "Да, один раз за сессию. Приложение получает свежие данные из Instagram и кэширует их, чтобы контент оставался актуальным. Если открыть Performance снова в течение того же 90-секундного окна, кэшированная версия появится мгновенно — без нового запроса.";

"faq.q.new_photo.question" = "Я загрузил новое фото в Instagram. Когда оно появится?";
"faq.q.new_photo.answer" = "Новое фото появится при следующем открытии Performance — как правило, в течение 90 секунд после публикации в Instagram. Приложение всегда получает последние публикации при входе, поэтому ничего делать вручную не нужно.";

"faq.q.reels_slow.question" = "Reels и отмеченный контент загружаются медленно. Это нормально?";
"faq.q.reels_slow.answer" = "Reels и отмеченные фото автоматически загружаются в фоне через несколько секунд после появления публикаций, чтобы быть готовыми до того, как вы перелистнёте на эти вкладки. После загрузки они сохраняются и появляются мгновенно в будущих сессиях — без интернета.";

"faq.q.no_data.question" = "Что будет, если при открытии Performance нет интернета?";
"faq.q.no_data.answer" = "Последняя сохранённая версия профиля отображается немедленно из кэша — публикации, фото профиля, счётчики и всё остальное. Приложение попытается незаметно обновиться, когда соединение восстановится, но вы можете выступать без перебоев даже офлайн.";

"faq.q.bot.question" = "Может ли использование Vault заблокировать мой аккаунт Instagram?";
"faq.q.bot.answer" = "Vault разработан с учётом ограничений Instagram. Приложение автоматически распределяет запросы, соблюдает периоды ожидания и никогда не отправляет массовые действия. При нормальном использовании риск минимален. Избегайте выполнения десятков трюков подряд за очень короткое время — приложение уже предотвращает это автоматически.";

"faq.q.not_instagram.question" = "Зрители спрашивают, почему приложение похоже на Instagram. Что сказать?";
"faq.q.not_instagram.answer" = "Performance — это точная визуальная копия вашего профиля Instagram: тот же макет, те же фото, те же счётчики. Если кто-то спросит, можно просто сказать, что вы проверяете свой Instagram, ведь отображаемые данные реальны и поступают напрямую из вашего аккаунта.";

"upload.tip.title" = "Можно оставить загрузку";
"upload.tip.overnight" = "Пока загрузка активна, экран остаётся включён — телефон никогда не заблокируется и не потухнет. Подключите его к зарядке и оставьте на всю ночь, чтобы заполнить 10 и более банков, не касаясь его.";
"upload.tip.background" = "Хотите пользоваться телефоном? Свободно переключайтесь на любое другое приложение. Всплывающее уведомление вернёт вас сюда, когда следующее фото будет готово к загрузке.";


