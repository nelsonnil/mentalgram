"postpred.help.nav.title" = "Пост-предсказание";
"postpred.help.nav.subtitle" = "Руководство по выступлению";
"postpred.help.hero.title" = "Предсказание изображения";
"postpred.help.hero.body" = "Выбранное изображение появляется в вашем профиле Instagram на исходном месте с исходной датой, выбранное зрителем в реальном времени.";
