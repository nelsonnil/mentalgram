// ── Limits & Safety help (simplified) ──
"limits.help.title" = "Лимиты и безопасность";

"limits.help.calm.title" = "Спокойствие — всё под контролем";
"limits.help.calm.body" = "Instagram иногда показывает короткое уведомление с просьбой подтвердить, что это действительно вы. Это совершенно нормально для любого приложения, подключённого к платформе, и никак не связано с блокировкой. Vault разработан с теми же защитными мерами против ботов, которые используют реальные приложения, и каждая из них тщательно протестирована.";
"limits.help.calm.infobox" = "Я лично вызывал такое уведомление более 100 раз во время разработки, и мой аккаунт ни разу не был заблокирован. Другие приложения с таким же подходом работают без проблем — если бы существовал реальный риск, Vault не был бы опубликован.";

"limits.help.budget.title" = "Что расходует твой часовой бюджет";
"limits.help.budget.intro" = "Instagram разрешает около 55 API-действий в час на сессию. Приложение отслеживает это автоматически. Вот что считается — и что нет:";
"limits.help.budget.free" = "БЕСПЛАТНО";
"limits.help.budget.free.items" = "Прокрутка сетки · Анимация кнопки громкости · Ввод секретных цифр · Просмотр уже открытых профилей (кэш) · Навигация по Настройкам или Руководству";
"limits.help.budget.low" = "НИЗКОЕ";
"limits.help.budget.low.items" = "Открытие приложения (1) · Загрузка списка подписчиков (1) · Раскрытие буквы/фото (по 1) · Counter Glitch — первое открытие нового профиля (4) · Поиск профиля (2)";
"limits.help.budget.high" = "ВЫСОКОЕ";
"limits.help.budget.high.items" = "Sync & Archive — 2 запроса на фото · Загрузка фото — 1 запрос на фото · Открытие 5 разных профилей подписчиков — ~20 запросов";
"limits.help.budget.reset" = "Бюджет сбрасывается каждые 60 минут. Если приложение автоматически ставит паузу, значит лимит исчерпан — подожди, и оно возобновится само.";
"limits.help.rehearsal.title" = "Безопасные репетиции — золотые правила";
"limits.help.rehearsal.body" = "Большинство случаев обнаружения ботов происходит во время тестирования, а не во время выступлений. Несколько простых привычек устраняют 90% риска:";
"limits.help.rehearsal.tip1" = "Открой профиль одного и того же подписчика один раз → он кэшируется на дни. Репетируй Counter Glitch сколько угодно раз с одним человеком — это бесплатно.";
"limits.help.rehearsal.tip2" = "Распредели Sync & Archive и загрузки фото по разным часам — не накапливай всё прямо перед выступлением.";
"limits.help.rehearsal.avoid1" = "Не открывай 4–5 разных профилей подписчиков подряд во время репетиции. Каждый новый профиль стоит ~4 API-запроса.";
"limits.help.rehearsal.avoid2" = "Не перезапускай приложение многократно во время тестирования — каждый перезапуск запускает проверку сессии.";
"limits.help.rehearsal.tip" = "Самая безопасная репетиция: открой именно того подписчика, которого будешь использовать, выполни эффект один раз, вернись назад. Повторяй эту же последовательность → со второго раза она совершенно бесплатна.";
"limits.help.warning.title" = "Если появилось уведомление \"Необычная активность\"";
"limits.help.warning.intro" = "Не беспокойтесь — это не блокировка. Instagram просто подтверждает, что это действительно вы. Выполните эти шаги:";
"limits.help.warning.step1" = "Откройте официальное приложение Instagram и нажмите \"Dismiss\" в уведомлении.";
"limits.help.warning.step2" = "Если запросит проверку, завершите её кодом из email или SMS.";
"limits.help.warning.step3" = "В Vault выйдите из аккаунта в Настройках, подождите около минуты и войдите снова.";
"limits.help.warning.step4" = "Можно продолжать — ваш аккаунт в безопасности.";
"limits.help.warning.reassure" = "Ваш аккаунт продолжает работать как обычно. Это только приостанавливает Vault на несколько минут, и ничего больше.";

"limits.help.show.title" = "Во время выступления";
"limits.help.show.body" = "Если уведомление появляется, пока зритель смотрит на экран, Vault скрывает все технические детали и показывает стандартный экран \"Нет подключения к интернету\".";
"limits.help.show.infobox" = "Идеальное оправдание: \"Ой, Instagram на секунду завис, ничего страшного.\" Ни один зритель не увидит ничего технического.";

"limits.help.best.title" = "Рекомендации";
"limits.help.best.item1" = "Не повторяйте один и тот же эффект несколько раз подряд в одной сессии — алгоритм может отметить это как автоматизацию.";
"limits.help.best.item2" = "Готовьте свои сеты (Sync & Archive) накануне вечером или хотя бы за час до выступления, а не сразу после репетиции.";
"limits.help.best.item3" = "Если вы часто выступаете, используйте отдельный Instagram-аккаунт, не связанный с основным.";
"limits.help.best.item4" = "Vault автоматически управляет всеми периодами ожидания — вам не нужно ни о чём думать.";

"limits.help.testing.title" = "Почему Instagram может запросить проверку безопасности?";
"limits.help.testing.body" = "Во время тестирования приложения для Instagram нормально обнаруживать необычную активность. При тестировании выполняется много действий подряд — изменения биографии, заметки, раскрытие фотографий — за короткое время и на новых аккаунтах, что может выглядеть как автоматизированное поведение для систем безопасности Instagram.\n\nВо время реального выступления этого никогда не происходит: действия естественно разделены ритмом выступления, что делает всё похожим на обычное использование человеком.";
"limits.help.testing.fix" = "Если Instagram просит подтвердить адрес электронной почты или номер телефона, это просто разовая проверка безопасности. Пройдите её через браузер на instagram.com, и аккаунт снова заработает в обычном режиме.";

"limits.help.session.title" = "Если app показывает экран \"Нет интернета\"";
"limits.help.session.body" = "Иногда Instagram временно отзывает сессию — тогда app показывает обычный экран \"Нет соединения\", чтобы зрители не видели ничего технического. Это не бан.\n\nЧтобы увидеть настоящее объяснение и решить проблему, нажмите кнопку ⓘ в правом нижнем углу этого экрана.";
"limits.help.session.case1.label" = "Появляется только кнопка Закрыть";
"limits.help.session.case1.action" = "Нажмите Закрыть в приложении Instagram и сразу вернитесь сюда для повторного входа. Ждать не нужно — войдёте мгновенно.";
"limits.help.session.case2.label" = "Отображается конкретная дата окончания";
"limits.help.session.case2.action" = "Подождите до этой даты, затем войдите снова. Instagram ввёл короткую паузу — ваш аккаунт в порядке.";
"limits.help.session.case3.label" = "Запрашивается код через телефон или e-mail";
"limits.help.session.case3.action" = "Сначала пройдите верификацию в приложении Instagram. После этого вернитесь сюда и нажмите Войти снова.";
"limits.help.session.new_account" = "Новые аккаунты с небольшой историей активности сталкиваются с этим чаще. Постепенно наращивайте посты, подписчиков и взаимодействия — Instagram гораздо больше доверяет аккаунтам с устоявшейся историей.";
"limits.help.session.contact" = "Если обнаружение бота продолжается, свяжитесь с разработчиком и поделитесь журналами (Настройки → Экспортировать журналы). Это поможет проанализировать проблему и улучшить защиту для всех.";

"limits.help.gauge.title" = "Ваш часовой бюджет: 55 действий";
"limits.help.gauge.body" = "Instagram ограничивает каждое подключённое приложение до 55 действий в час. Бюджет работает как скользящее 60-минутное окно — каждое действие истекает ровно через 60 минут после выполнения, поэтому счётчик снижается автоматически без жёсткого сброса.";
